# For local commands, export these values (Django does not auto-load this file).
# Default SQLite path is <project>/data/passport.db. Mount /app/data in Docker.
DATABASE_URL=sqlite:///./data/passport.db
# DATABASE_URL=mysql://passport:password@mysql:3306/passport
# Required for multiple ASGI workers / API replicas (shared channel delivery).
# REDIS_URL=redis://localhost:6379/0
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-publishing
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
